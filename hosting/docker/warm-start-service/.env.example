# Warm Start Service Configuration

# Port for the warm start service
WARM_START_PORT=3040

# Enable debug logging (0 = disabled, 1 = enabled)
WARM_START_DEBUG=0

# Connection timeout for long-polling requests (milliseconds)
WARM_START_CONNECTION_TIMEOUT_MS=30000

# Keepalive duration for warm workers (milliseconds)
WARM_START_KEEPALIVE_MS=300000

# Worker timeout - should be slightly longer than keepalive (milliseconds)
WARM_START_WORKER_TIMEOUT_MS=310000

